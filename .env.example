# Copy to .env.local and adjust.

# true  = run against the built-in mock API (no backend needed)
# false = talk to the real PayBridge backend
VITE_USE_MOCK=true

# Where the browser sends API calls. Leave as /api in development: Vite forwards it to the backend.
VITE_API_BASE_URL=/api

# Where Vite forwards /api in development (your Spring Boot app).
VITE_API_PROXY_TARGET=http://localhost:8080
